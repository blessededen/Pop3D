# Copy to .env.local. Credentials stay on the server; never use VITE_* for secrets.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
PORT=8787

# Kakao account login and optional Talk connection (server only)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:5174/api/auth/kakao/callback

# Public HTTPS origin on Vercel. Leave blank for local development.
POP3D_PUBLIC_URL=

# Account/project database for Node or RP5. Must be a persistent local disk path.
# Default is .data/accounts.sqlite; never commit this database.
POP3D_ACCOUNT_DB=

# Vercel: persistent Neon Postgres connection string, server only.
# When set, it replaces SQLite. Existing local data is not automatically uploaded.
DATABASE_URL=
